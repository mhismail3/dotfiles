#!/usr/bin/env bash

# .macos — System preferences for test-host (headless build/test Mac mini)
# Run: source ~/.dotfiles/macos/.macos
# Only what an unattended build box needs: name, remote access, never sleep,
# auto-login (simulators and UI tests need a GUI session), no update surprises,
# and lean background services.

osascript -e 'tell application "System Settings" to quit' 2>/dev/null || true

sudo -v < /dev/tty
while true; do sudo -n true; sleep 60; kill -0 "$$" || exit; done 2>/dev/null &

MACOS_USER="${MACOS_USER:-$(whoami)}"
HOST_NAME="${HOST_NAME:-tron-test-mini}"

###############################################################################
# Computer name
###############################################################################

echo "Setting computer name to $HOST_NAME..."
sudo scutil --set ComputerName "$HOST_NAME"
sudo scutil --set HostName "$HOST_NAME"
sudo scutil --set LocalHostName "$HOST_NAME"

###############################################################################
# Remote access: SSH + Screen Sharing (for the odd GUI prompt)
###############################################################################

echo "Enabling remote access..."
sudo systemsetup -setremotelogin on 2>/dev/null || \
    echo "  Enable manually: System Settings > General > Sharing > Remote Login"
sudo dseditgroup -o create -q com.apple.access_ssh 2>/dev/null || true
sudo dseditgroup -o edit -a "$MACOS_USER" -t user com.apple.access_ssh 2>/dev/null || true
sudo launchctl enable system/com.apple.screensharing 2>/dev/null || true
sudo launchctl bootstrap system /System/Library/LaunchDaemons/com.apple.screensharing.plist 2>/dev/null || true

###############################################################################
# Power: always on, recover by itself
###############################################################################

echo "Configuring power management..."
sudo pmset -a sleep 0 displaysleep 0 disksleep 0
sudo pmset -a hibernatemode 0 standby 0 powernap 0 proximitywake 0
sudo pmset -a womp 1 tcpkeepalive 1 ttyskeepawake 1 autorestart 1
sudo systemsetup -setrestartfreeze on 2>/dev/null || true

###############################################################################
# Auto-login (requires FileVault off)
###############################################################################

echo "Configuring auto-login for $MACOS_USER..."
sudo defaults write /Library/Preferences/com.apple.loginwindow autoLoginUser -string "$MACOS_USER"
defaults write com.apple.screensaver idleTime -int 0
defaults -currentHost write com.apple.screensaver idleTime -int 0

###############################################################################
# Updates: notify only — never move Xcode or macOS under a running test lane
###############################################################################

echo "Configuring updates (check only, never auto-install)..."
sudo defaults write /Library/Preferences/com.apple.SoftwareUpdate AutomaticCheckEnabled -bool true
sudo defaults write /Library/Preferences/com.apple.SoftwareUpdate AutomaticDownload -bool false
sudo defaults write /Library/Preferences/com.apple.SoftwareUpdate AutomaticallyInstallMacOSUpdates -bool false
sudo defaults write /Library/Preferences/com.apple.SoftwareUpdate CriticalUpdateInstall -bool true
sudo defaults write /Library/Preferences/com.apple.commerce AutoUpdate -bool false
defaults write com.apple.commerce AutoUpdate -bool false

###############################################################################
# Minimal UI/Finder hygiene
###############################################################################

defaults write NSGlobalDomain NSDocumentSaveNewDocumentsToCloud -bool false
defaults write com.apple.desktopservices DSDontWriteNetworkStores -bool true
defaults write com.apple.desktopservices DSDontWriteUSBStores -bool true
defaults -currentHost write com.apple.Spotlight MenuItemHidden -int 1
defaults write com.apple.ScreenTime Enabled -bool false 2>/dev/null || true
defaults write com.apple.AdLib allowApplePersonalizedAdvertising -bool false
defaults write com.apple.assistant.support "Assistant Enabled" -bool false
defaults write com.apple.Siri StatusMenuVisible -bool false
defaults write com.apple.Siri UserHasDeclinedEnable -bool true

###############################################################################
# Lean background services (Spotlight indexing off, idle agents disabled)
###############################################################################

source "${DOTFILES:-$HOME/.dotfiles}/macos/lean.sh"

for app in "Finder" "Dock" "SystemUIServer"; do
    killall "${app}" &>/dev/null || true
done

cat <<EOF

━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
  MANUAL STEPS (once)
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
  1. FileVault OFF (System Settings > Privacy & Security), so auto-login works.
  2. Users & Groups > Automatic login: $MACOS_USER (appears after FileVault off).
  3. Do NOT sign in to iCloud/Apple Account at the OS level.
  4. Ethernet preferred; reserve a DHCP address for $HOST_NAME on the router.
  5. Restart, then from the main Mac: ssh $MACOS_USER@$HOST_NAME
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

EOF
